<?xml version="1.0" encoding="utf-8"?>

<robot name="rm_gimbal"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="xyz_camera" default="0 0 0" /> 
  <xacro:arg name="xyz_muzzle" default="0 0 0" />
  <xacro:arg name="rpy" default="0 0 0" />
  <xacro:arg name="xyz_lidar" default="0 0 0" />
  <xacro:arg name="rpy_lidar" default="0 0 0" />

  <link name="gimbal_link" />

  <link name="muzzle_link" />
  <link name="camera_link" />
  <link name="camera_optical_frame" />
  <link name="livox_frame" />

  <joint name="muzzle_joint" type="fixed">
  <origin xyz="$(arg xyz_muzzle)" rpy="$(arg rpy)" />
    <parent link="gimbal_link" />
    <child link="muzzle_link" />
  </joint>

  <joint name="camera_joint" type="fixed">
    <origin xyz="$(arg xyz_camera)" rpy="$(arg rpy)" />
    <parent link="muzzle_link" />
    <child link="camera_link"/>
    <axis xyz="0 0 0" />
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    <parent link="gimbal_link" />
    <child link="camera_optical_frame" />
  </joint>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="$(arg xyz_lidar)" rpy="$(arg rpy_lidar)" />
    <parent link="gimbal_link" />
    <child link="livox_frame" />
  </joint>

</robot>
